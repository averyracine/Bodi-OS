# Copy to .env.local. Placeholders only. Never commit real values.
# With everything blank the app runs in isolated demo mode (local-only, no payments).

# Public base URL used for auth redirects, Stripe return URLs and pairing QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API). Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only secret key (bypasses RLS). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Stripe TEST mode only for this MVP (the server refuses sk_live_ outside production).
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Either a lookup key (preferred) or a price id for a USD 10.00 / month recurring price.
STRIPE_PRICE_LOOKUP_KEY=command_center_monthly_usd_10
# STRIPE_PRICE_ID=price_REPLACE_ME

# 32+ random characters, used to HMAC pairing codes, poll secrets and device tokens.
# Generate with: openssl rand -base64 48
PAIRING_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
